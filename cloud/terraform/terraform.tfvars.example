# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is (and must stay) gitignored -- it will hold your DB password.

aws_region  = "us-east-1"
db_password = "change-me-to-a-real-password"

# Find yours with: curl ifconfig.me
# Then append /32, e.g. "203.0.113.4/32"
my_ip_cidr = "REPLACE_WITH_YOUR_IP/32"
