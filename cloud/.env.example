# Copy to cloud/.env, fill in real values, then before running anything in
# cloud/: `export $(grep -v '^#' cloud/.env | xargs)`
# Never commit the real .env file (it's already in .gitignore).

# Used by cloud/pipeline/db.py (Python) -- one connection string.
# Local test Postgres:
#   DATABASE_URL=postgresql://cashpulse:yourpassword@localhost:5432/cashpulse
# AWS RDS (host comes from `terraform output rds_endpoint` after `terraform apply`):
#   DATABASE_URL=postgresql://cashpulse:yourpassword@cashpulse-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/cashpulse
DATABASE_URL=postgresql://cashpulse:yourpassword@localhost:5432/cashpulse

# Used by dbt (cloud/dbt/cashpulse_dbt/profiles.yml) -- same database, split
# into parts because dbt's profiles.yml reads individual env vars, not a URL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=cashpulse
DB_PASSWORD=yourpassword
DB_NAME=cashpulse

# Only needed if you provision the S3 landing zone via Terraform and want to
# write to it directly from Python (optional stretch goal -- not required
# for the core pipeline, which lands data straight into Postgres's raw schema).
AWS_REGION=us-east-1
S3_RAW_BUCKET=
